PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 3579191078589747711, guid: c280091d60143d44b9422b1da6661965, type: 3}
      propertyPath: moveSpeed
