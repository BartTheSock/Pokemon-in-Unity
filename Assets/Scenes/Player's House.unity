      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2404392190011802103, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: Hi, playerName! I just wanted to let you know that I got a call from
        Professor Oak.
      objectReference: {fileID: 0}
    - target: {fileID: 2404392190011802103, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
      value: "He's taking a vacation here in Flosha, and he wanted to give you a
        Pok\xE9mon!"
      objectReference: {fileID: 0}
    - target: {fileID: 2404392190011802103, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[2]'
      value: "I don't know what kind of Pok\xE9mon he has for you, but you should
        go check it out anyway!"
      objectReference: {fileID: 0}
    - target: {fileID: 2404392190011802103, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[3]'
      value: "If you end up deciding to go on an adventure or something, here's 5
        Pok\xE9 Balls to catch Pok\xE9mon with."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: "You look a bit tired, playerName. I think you and your Pok\xE9mon should
        rest for a bit."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
