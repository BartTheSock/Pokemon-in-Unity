      value: 
      objectReference: {fileID: 11400000, guid: ad7fa7f122833c444b04396ab84a26e8, type: 2}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: pokemonToGive.level
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: "Hello there, playerName! I wish I could give you a choice between three
        Pok\xE9mon, but I only have this Charmander."
      objectReference: {fileID: 0}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
      value: "I should be able to have one of my aides back in Kanto send over some
        other Pok\xE9mon through the PC system."
      objectReference: {fileID: 0}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[2]'
      value: "If you want to get another Pok\xE9mon, I suggest you wait a while until
        I can get some more."
      objectReference: {fileID: 0}
    - target: {fileID: 2997041401614440088, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[3]'
      value: "Or you could always catch Pok\xE9mon using Pok\xE9 Balls."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: maxX
