    - target: {fileID: 2404392190011802103, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[0]'
      value: "Oh! Come to think of it, I also have a bunch of Pok\xE9 Balls for you
