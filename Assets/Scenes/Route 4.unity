    - target: {fileID: 1747727796819585287, guid: e166e92400ba39f4d8328f907585579c, type: 3}
      propertyPath: dialogEndBattle
      value: "Dang it! This just makes me hate Pok\xE9mon even more!"
      objectReference: {fileID: 0}
    - target: {fileID: 1747727796819585287, guid: e166e92400ba39f4d8328f907585579c, type: 3}
      propertyPath: isSpecialTrainer
      value: 1
