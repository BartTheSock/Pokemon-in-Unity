  m_FontData:
    m_Font: {fileID: 12800000, guid: 320fd6f75752fb440932ca0c26d041b1, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
