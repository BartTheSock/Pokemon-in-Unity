      propertyPath: 'dialog.lines.Array.data[0]'
      value: "Hello, and welcome to the Pok\xE9mon Center."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[1]'
      value: "We restore your tired Pok\xE9mon to full health."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[2]'
      value: "Let me take your Pok\xE9mon for a few seconds."
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[3]'
      value: "All you do is use boring moves against Pok\xE9mon and throw Pok\xE9
        Balls at them"
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[4]'
      value: ...What? You want me to stop talking?
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[5]'
      value: Well, exCUSE me for being opinionated, kid.
      objectReference: {fileID: 0}
    - target: {fileID: 3426201063670062914, guid: 4d2f8c7993e82cc4693bba9d610af5cb, type: 3}
      propertyPath: 'dialog.lines.Array.data[6]'
      value: Not everyone understands and appreciates video games like you young
        people, you know.
      objectReference: {fileID: 0}
