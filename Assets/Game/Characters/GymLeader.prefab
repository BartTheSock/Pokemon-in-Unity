  m_Name: 
  m_EditorClassIdentifier: 
  trainerSprite: {fileID: 982394477618474989, guid: 6856d66060a7dbd468d72fbf04a6884d, type: 3}
  trainerName: Falkner
  trainerClass: Gym Leader
  dialog:
    lines:
    - "Okay, I can guess what you're thinking, and I know that none of my Pok\xE9mon
      were even Level 10 back in Johto, but I've been training!"
    - "I still want to be the world's best bird Pok\xE9mon master, just like my dad,
      so I also got some new bird Pok\xE9mon in addition to my Pidgey and Pidgeotto!"
    - Do you still want to battle me? All right then, let's see what you're made
      of!
  dialogEndBattle: Wow! You completely walloped me!
  dialogAfterBattle:
    lines:
    - Good luck on your adventure!
  dialogRefuseBattle:
    lines: []
